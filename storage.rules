rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // COC / Feasibility eski dokümanlar (appData/cocCertificates, appData/feasibilityAttachments)
    match /appData/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // FAI ekleri (fai/{year}/{faiNo}/{safeCat}_{ts}_{name})
    match /fai/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // COC alt bileşen dokümanları (coc/{year}/{certNo}/sub/...)
    match /coc/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
